rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Document ID is the share token itself. Knowing the token is the capability.
    function hasValidShareToken(cdId) {
      return request.query.keys().hasAll(['token'])
        && request.query.token is string
        && exists(/databases/$(database)/documents/shareTokens/$(request.query.token))
        && get(/databases/$(database)/documents/shareTokens/$(request.query.token)).data.cdId == cdId 
        && get(/databases/$(database)/documents/shareTokens/$(request.query.token)).data.expiresAt > request.time;
    }

    function isAccessCountOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accessCount'])
        && request.resource.data.accessCount == resource.data.accessCount + 1
        && resource.data.expiresAt > request.time;
    }
    
    // Users collection — email and account fields are private to the owner.
    // Public profile data lives in usernames/ and publicCDs/.
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.email is string;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
    
    // CDs collection
    match /cds/{cdId} {
      allow read: if isOwner(resource.data.userId) 
                  || hasValidShareToken(cdId)
                  || (resource.data.isPublic == true);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
      
      match /files/{fileId} {
        allow read: if isOwner(get(/databases/$(database)/documents/cds/$(cdId)).data.userId) 
                    || hasValidShareToken(cdId)
                    || (get(/databases/$(database)/documents/cds/$(cdId)).data.isPublic == true);
        allow write: if isOwner(get(/databases/$(database)/documents/cds/$(cdId)).data.userId);
      }
    }
    
    // ShareTokens — document ID must equal the secret token string.
    // Anyone who knows the token can get that one doc; listing the collection is denied.
    match /shareTokens/{tokenId} {
      allow get: if true;
      allow list: if isAuthenticated()
        && resource.data.createdBy == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.token == tokenId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.cdId is string
        && exists(/databases/$(database)/documents/cds/$(request.resource.data.cdId))
        && isOwner(get(/databases/$(database)/documents/cds/$(request.resource.data.cdId)).data.userId);
      allow update: if isOwner(resource.data.createdBy) || isAccessCountOnlyUpdate();
      allow delete: if isOwner(resource.data.createdBy);
    }
    
    // EmailLogs collection
    match /emailLogs/{logId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId);
    }
    
    // Usernames — public handles for profiles and uniqueness checks (no email).
    match /usernames/{usernameL} {
      allow read: if true;
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.username is string;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() 
        && resource.data.userId == request.auth.uid;
    }
    
    // PublicCDs — marketplace index
    match /publicCDs/{cdId} {
      allow read: if true;
      allow write: if isAuthenticated() 
        && exists(/databases/$(database)/documents/cds/$(cdId))
        && isOwner(get(/databases/$(database)/documents/cds/$(cdId)).data.userId);
    }
    
    // CDViews — analytics
    match /cdViews/{cdId} {
      allow read: if isAuthenticated() 
        && isOwner(get(/databases/$(database)/documents/cds/$(cdId)).data.userId);
      allow create: if isAuthenticated();
      allow update, delete: if false;
      
      match /viewers/{viewerId} {
        allow read: if isAuthenticated() 
          && isOwner(get(/databases/$(database)/documents/cds/$(cdId)).data.userId);
        allow create, update: if isAuthenticated() && request.auth.uid == viewerId;
      }
    }
  }
}
